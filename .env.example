# LLM provider — "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Per-tier model overrides (leave empty to use provider defaults)
#   anthropic defaults: low=claude-haiku-4-5, mid=claude-sonnet-4-6, high=claude-opus-4-7
#   openai    defaults: low=gpt-5-mini,        mid=gpt-5-mini,         high=gpt-5
MODEL_LOW=
MODEL_MID=
MODEL_HIGH=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=        # e.g. -1001234567890 (broadcast channel)
TELEGRAM_DISCUSSION_GROUP_ID= # e.g. -1009876543210 (linked discussion group)
ADMIN_TG_USER_ID=           # numeric Telegram user-id of the owner

# GitHub (read-only PAT, public_repo scope only)
GITHUB_TOKEN=

# Embeddings
VOYAGE_API_KEY=

# Storage
AI_NEWS_DB=/data/news.db

# Budget / rate-limits
DAILY_TOKEN_BUDGET=2000000     # tokens per UTC day across all skills
MAX_POSTS_PER_HOUR=8
QA_PER_USER_PER_HOUR=10

# Behaviour
TIMEZONE=Asia/Tehran
DRY_RUN=0                      # 1 = log Telegram payloads instead of sending

# OpenClaw gateway auth (control UI on 127.0.0.1; rotate routinely)
OPENCLAW_GATEWAY_TOKEN=
