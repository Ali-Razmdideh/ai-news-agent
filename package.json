{
  "name": "ai-news",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw-driven multi-agent AI-news curator → Telegram",
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skill": "node --experimental-strip-types"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "vitest": "^2.1.0"
  }
}
